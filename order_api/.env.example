# ─── Aplikasi ────────────────────────────────────────
APP_NAME=Product & Merchant API
APP_VERSION=1.0.0
DEBUG=true

# ─── Database ────────────────────────────────────────
# SQLite (default, file lokal):
DATABASE_URL=sqlite:///./store.db
# Contoh PostgreSQL lokal:
# DATABASE_URL=postgresql://user:password@localhost:5432/store
# Contoh Neon (production):
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── Auth / JWT ──────────────────────────────────────
# WAJIB diganti & dirahasiakan di production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-string-acak-panjang

# ─── Frontend ────────────────────────────────────────
# Tujuan redirect setelah scan QR dining table.
FRONTEND_URL=http://localhost:3000

# ─── CORS ────────────────────────────────────────────
# Daftar origin dipisah koma. Gunakan * untuk mengizinkan semua.
CORS_ORIGINS=*
