# ─── Aplikasi ────────────────────────────────────────
APP_NAME=Product & Merchant API
APP_VERSION=1.0.0
DEBUG=true

# ─── Database ────────────────────────────────────────
# SQLite (default, file lokal):
DATABASE_URL=sqlite:///./store.db
# Contoh PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/store

# ─── CORS ────────────────────────────────────────────
# Daftar origin dipisah koma. Gunakan * untuk mengizinkan semua.
CORS_ORIGINS=*
